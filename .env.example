# Optional settings. PackDesk works without a .env file: the installation wizard asks for what it needs.
# Copy this file to .env to set things in advance (e.g. for an automated installation). A value here
# always wins over what the wizard saved. Never put .env in Git.

# --- General ---
# Installation code for the installation wizard and the "Update database" page. Empty = a random
# code, shown with: docker compose logs web | grep "Installation code"
SETUP_CODE=
# Port PackDesk listens on, and the folder on this computer for all its files (mounted as /data).
PORT=8000
DATA_DIR=../packdesk-data

# phpMyAdmin (docker-compose.mariadb.yml only). Default: http://127.0.0.1:8081, only on the server itself.
# PHPMYADMIN_PORT=8081
# PHPMYADMIN_ADDRESS=127.0.0.1    (0.0.0.0 = reachable from the network; only on a trusted network)
# Long random text, kept secret. Empty = made by PackDesk and kept in the data folder. Changing it
# logs everyone out and makes stored passwords (mail server, external databases) unreadable.
SECRET_KEY=

# --- Database ---
# docker-compose.yml and docker-compose.mariadb.yml run their own database; you may only set its
# password here (set it before the first start).
DB_PASSWORD=
# docker-compose.external-db.yml: an existing database server. Empty = asked by the wizard.
# DB_ENGINE=mariadb            (mariadb, also for MySQL; or postgres)
# DB_HOST=<IP address or name>
# DB_PORT=                     (empty = 3306 MariaDB, 5432 PostgreSQL)
# DB_NAME=packdesk
# DB_USER=packdesk

# --- Mail server (outgoing mail) ---
# Empty = set in the wizard or in the admin under Settings → Mail server.
# EMAIL_HOST=<SMTP server>
# EMAIL_PORT=587
# EMAIL_HOST_USER=<SMTP user>
# EMAIL_HOST_PASSWORD=<SMTP password>
# EMAIL_USE_TLS=1              (STARTTLS, usually port 587; or EMAIL_USE_SSL=1 for port 465)
# Sender when the settings in the admin give none.
# DEFAULT_FROM_EMAIL=noreply@shop.example.com

# --- On the internet (behind a reverse proxy that handles HTTPS) ---
# SECURE_COOKIES=1
# SECURE_SSL_REDIRECT=1
# CSRF_TRUSTED_ORIGINS=https://shop.example.com
# Turn on (e.g. 31536000) only once HTTPS works everywhere on the domain.
# SECURE_HSTS_SECONDS=0
# Fixed list of host names. Empty = the domain name from the admin (Settings → General) is used.
# ALLOWED_HOSTS=shop.example.com

# --- Optional sources ---
# Folder with the previous webshop's invoice PDFs, mounted read-only via docker-compose.override.yml
# (see docs/installatie.md). Empty for a new installation.
DOCUMENT_ARCHIVE=

# --- Other ---
# Apply database changes of a new version at start-up instead of with the button in the browser.
# RUN_MIGRATIONS=1
# Order of languages shown when a translation is empty.
# FALLBACK_LANGUAGES=nl,en,de
# Amount of logging: DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO

# --- Development only (docker-compose.dev.yml) ---
# COMPOSE_FILE=docker-compose.dev.yml
# Database container for development: postgres or mariadb (then DB_HOST=postgres or mariadb).
# COMPOSE_PROFILES=postgres
# DB_ROOT_PASSWORD=<only for the MariaDB development container>
