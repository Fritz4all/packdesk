# Copy to .env and fill in. Never put .env in Git.
#
# docker-compose.yml is meant for development and sets DEBUG, SECRET_KEY, ALLOWED_HOSTS and the mail
# server itself; there only the database and folder lines below are used. On a server all lines apply.

# --- General ---
# Long random text, kept secret. Changing it logs everyone out and makes stored passwords of
# external databases unreadable (enter those again).
SECRET_KEY=<SECRET_KEY>
DEBUG=0
# Installation code for the installation wizard and the "Update database" page. Leave empty to get a
# random code, shown with: docker compose logs web | grep "Installation code"
SETUP_CODE=
# Domain name(s) of the shop, comma separated, and the same with https:// in front.
ALLOWED_HOSTS=shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com

# --- Database of PackDesk itself (always its own database, also on a shared server) ---
# postgres or mariadb (mariadb also covers MySQL).
DB_ENGINE=mariadb
# IP address or name of the database server; "postgres" or "mariadb" for a database container.
DB_HOST=<DB_HOST>
# Empty = standard port (5432 PostgreSQL, 3306 MariaDB).
DB_PORT=
DB_NAME=packdesk
DB_USER=packdesk
DB_PASSWORD=<DB_PASS>
# Database container (docker-compose only): empty for an existing server, or postgres / mariadb.
COMPOSE_PROFILES=
# Only for a MariaDB container.
DB_ROOT_PASSWORD=<DB_ROOT_PASS>

# --- Mail server (outgoing mail) ---
EMAIL_HOST=<SMTP_HOST>
EMAIL_PORT=587
EMAIL_HOST_USER=<SMTP_USER>
EMAIL_HOST_PASSWORD=<SMTP_PASS>
# 1 for STARTTLS (usually port 587), or EMAIL_USE_SSL=1 for port 465.
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
# Sender when the settings in the admin give none.
DEFAULT_FROM_EMAIL=noreply@shop.example.com

# --- HTTPS (behind a reverse proxy that handles the certificate) ---
SECURE_COOKIES=1
SECURE_SSL_REDIRECT=1
# Turn on (e.g. 31536000) only once HTTPS works everywhere on the domain.
SECURE_HSTS_SECONDS=0

# --- Folders ---
# Folder on this computer/server for all files PackDesk keeps; mounted as /data. Not inside the
# Git folder.
DATA_DIR=../packdesk-data
# Optional: folder with the previous webshop's invoice PDFs, mounted read-only as
# /data-sources/archive-invoices (see docker-compose.yml). Empty for a new installation.
DOCUMENT_ARCHIVE=

# --- Other ---
# Order of languages shown when a translation is empty.
FALLBACK_LANGUAGES=nl,en,de
# Amount of logging: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
