# Copy to .env and fill in. Never commit .env.
SECRET_KEY=<SECRET_KEY>
DEBUG=0
# --- Database of PackDesk itself ---
# postgres or mariadb (mariadb also covers MySQL).
DB_ENGINE=mariadb
# IP address or name of the database server. Use "postgres" or "mariadb" for a database
# container started by docker-compose (see COMPOSE_PROFILES).
DB_HOST=<DB_HOST>
# Empty = standard port (5432 PostgreSQL, 3306 MariaDB).
DB_PORT=
DB_NAME=packdesk
DB_USER=packdesk
DB_PASSWORD=<DB_PASS>
# Only for a MariaDB container started by docker-compose.
DB_ROOT_PASSWORD=<DB_ROOT_PASS>
# Empty when using an existing database server; "postgres" or "mariadb" to run one in a container.
COMPOSE_PROFILES=
# Alternative to the DB_* lines: one URL, e.g. postgres://user:pass@host:5432/name
# DATABASE_URL=
# Host name(s) the shop is reached on, comma separated.
ALLOWED_HOSTS=shop.example.com
# Order of languages shown when a translation is empty.
FALLBACK_LANGUAGES=nl,en,de
# Full origin(s) when behind an HTTPS reverse proxy.
CSRF_TRUSTED_ORIGINS=https://shop.example.com
# Set to 1 when the site is served over HTTPS.
SECURE_COOKIES=1
SECURE_SSL_REDIRECT=1
# Enable HSTS only once HTTPS works on the domain.
SECURE_HSTS_SECONDS=0
EMAIL_HOST=<SMTP_HOST>
EMAIL_PORT=587
# Folder on the host for all files PackDesk keeps (website uploads, invoice PDFs, fault
# attachments, pending imports); mounted as /data. Never inside the Git folder.
DATA_DIR=../packdesk-data
# Optional: folder with the previous webshop's invoice PDFs (read-only, mounted as /data-archive through
# docker-compose.override.yml). Leave empty for an installation without previous webshop.
DOCUMENT_ARCHIVE=
