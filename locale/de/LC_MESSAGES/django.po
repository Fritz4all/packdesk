msgid_plural ""
"This password is too short. It must contain at least %(min_length)d "
"characters."
msgstr[0] ""
"Dieses Passwort ist zu kurz. Es muss mindestens %(min_length)d Zeichen "
"enthalten."
msgstr[1] ""
"Dieses Passwort ist zu kurz. Es muss mindestens %(min_length)d Zeichen "
"enthalten."

#: apps/accounts/password_rules.py:41
#, python-format
msgid "Your password must contain at least %(n)d character."
msgid_plural "Your password must contain at least %(n)d characters."
msgstr[0] "Ihr Passwort muss mindestens %(n)d Zeichen enthalten."
msgstr[1] "Ihr Passwort muss mindestens %(n)d Zeichen enthalten."

#: apps/accounts/password_rules.py:43
#, python-format
msgid ""
"Your password must contain at least %(staff)d characters for staff and "
"%(customers)d for customers."
msgstr ""
"Ihr Passwort muss für Mitarbeiter mindestens %(staff)d und für Kunden "
"mindestens %(customers)d Zeichen enthalten."

