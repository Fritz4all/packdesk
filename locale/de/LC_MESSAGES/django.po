#: apps/accounts/password_reset.py:23
#, python-format
msgid ""
"Dear %(name)s,\n"
"\n"
"For your account at %(company)s you need to choose a new password; your "
"current password no longer works.\n"
"\n"
"Choose your new password here (the link is valid for a few days):\n"
"%(link)s\n"
"\n"
"Expired? Use 'Forgot password' on the login page.\n"
msgstr ""
"Guten Tag %(name)s,\n"
"\n"
"für Ihr Konto bei %(company)s müssen Sie ein neues Passwort wählen; Ihr "
"aktuelles Passwort funktioniert nicht mehr.\n"
"\n"
"Wählen Sie hier Ihr neues Passwort (der Link ist einige Tage gültig):\n"
"%(link)s\n"
"\n"
"Abgelaufen? Verwenden Sie 'Passwort vergessen' auf der Anmeldeseite.\n"

#: apps/accounts/password_reset.py:27
#, python-format
msgid "Choose a new password for %(company)s"
msgstr "Wählen Sie ein neues Passwort für %(company)s"

#: apps/accounts/password_rules.py:33
#, python-format
