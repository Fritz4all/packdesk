#: apps/accounts/password_reset.py:23
#, python-format
msgid ""
"Dear %(name)s,\n"
"\n"
"For your account at %(company)s you need to choose a new password; your "
"current password no longer works.\n"
"\n"
"Choose your new password here (the link is valid for a few days):\n"
"%(link)s\n"
"\n"
"Expired? Use 'Forgot password' on the login page.\n"
msgstr ""
"Beste %(name)s,\n"
"\n"
"Voor uw account bij %(company)s moet u een nieuw wachtwoord kiezen; uw "
"huidige wachtwoord werkt niet meer.\n"
"\n"
"Kies hier uw nieuwe wachtwoord (de link is een paar dagen geldig):\n"
"%(link)s\n"
"\n"
"Verlopen? Gebruik 'Wachtwoord vergeten' op de inlogpagina.\n"

#: apps/accounts/password_reset.py:27
#, python-format
msgid "Choose a new password for %(company)s"
msgstr "Kies een nieuw wachtwoord voor %(company)s"

#: apps/accounts/password_rules.py:33
#, python-format
msgid ""
"This password is too short. It must contain at least %(min_length)d "
"character."
msgid_plural ""
"This password is too short. It must contain at least %(min_length)d "
"characters."
msgstr[0] ""
"Dit wachtwoord is te kort. Het moet minstens %(min_length)d teken bevatten."
msgstr[1] ""
"Dit wachtwoord is te kort. Het moet minstens %(min_length)d tekens bevatten."

#: apps/accounts/password_rules.py:41
#, python-format
msgid "Your password must contain at least %(n)d character."
msgid_plural "Your password must contain at least %(n)d characters."
msgstr[0] "Je wachtwoord moet minstens %(n)d teken bevatten."
msgstr[1] "Je wachtwoord moet minstens %(n)d tekens bevatten."

#: apps/accounts/password_rules.py:43
#, python-format
msgid ""
"Your password must contain at least %(staff)d characters for staff and "
"%(customers)d for customers."
msgstr ""
"Je wachtwoord moet minstens %(staff)d tekens bevatten voor medewerkers en "
"%(customers)d voor klanten."

