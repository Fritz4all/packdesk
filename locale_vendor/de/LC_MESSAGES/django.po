# Translations for third-party admin strings (django-unfold, django-modeltranslation)
# that those packages and Django itself do not translate.

msgid "Select record"
msgstr "Datensatz auswählen"

msgid "Select action"
msgstr "Aktion auswählen"

msgid "Select action to run"
msgstr "Auszuführende Aktion auswählen"

msgid "Raw passwords are not stored, so there is no way to see this user’s password, but you can change the password using <a href=\"{}\" class=\"text-primary-600 dark:text-primary-500\">this form</a>."
msgstr "Passwörter werden nicht im Klartext gespeichert, daher kann das Passwort dieses Benutzers nicht angezeigt werden. Sie können es jedoch mit <a href=\"{}\" class=\"text-primary-600 dark:text-primary-500\">diesem Formular</a> ändern."

msgid "Dataset not found. No action performed."
msgstr "Datensatz nicht gefunden. Keine Aktion ausgeführt."

msgid "Select value"
msgstr "Wert auswählen"

msgid "Field <strong class=\"font-semibold\">{field_name}</strong> is not an autocomplete field. Please add it to the `autocomplete_fields` list."
msgstr "Feld <strong class=\"font-semibold\">{field_name}</strong> ist kein Autocomplete-Feld. Bitte fügen Sie es zur Liste `autocomplete_fields` hinzu."

msgid "You can not create nested object without parent"
msgstr "Ein verschachteltes Objekt kann nicht ohne übergeordnetes Objekt erstellt werden"

msgid "Run"
msgstr "Ausführen"

